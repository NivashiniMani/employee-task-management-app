@page "/employees"  
@using BlazorApp1.Models
@using BlazorApp1.Services
@inject IEmployeeService EmployeeService
@inject IJSRuntime JS

<h3 class="mb-3">Employee Management</h3>

<!-- Search & Filter Section -->
<div class="row mb-3">
    <div class="col-md-4">
        <input class="form-control"
               @bind="searchTerm"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-3">
        <select class="form-control" @bind="selectedShift">
            <option value="">All Shifts</option>
            <option>Morning</option>
            <option>Evening</option>
            <option>Night</option>
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100"
                @onclick="async () => await LoadEmployees()">
            Search
        </button>
    </div>
</div>

<!-- Employee Table -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Shift</th>
            <th>Department</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (employees.Any())
        {
            @foreach (var emp in employees)
            {
                <tr>
                    <td>@emp.Name</td>
                    <td>@emp.Shift</td>
                    <td>@emp.Department</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2"
                                @onclick="() => EditEmployee(emp)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteEmployee(emp.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No employees found</td>
            </tr>
        }
    </tbody>
</table>

<hr />


@if (!string.IsNullOrEmpty(message))
{
    <div class=" alert alert-success mt-2">
        @message
    </div>
}

<!-- Add/Edit Form -->
<h5>@(isEditing ? "Edit Employee" : "Add Employee")</h5>

<EditForm Model="@newEmployee" OnValidSubmit="SaveEmployee">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row mb-2">
        <div class="col-md-4">
            <InputText class="form-control"
                       @bind-Value="newEmployee.Name"
                       placeholder="Employee Name" />
            <ValidationMessage For="@(() => newEmployee.Name)" />
        </div>

        <div class="col-md-3">
            <InputSelect class="form-control"
                         @bind-Value="newEmployee.Shift">
                <option value="">Select Shift</option>
                <option>Morning</option>
                <option>Evening</option>
                <option>Night</option>
            </InputSelect>
            <ValidationMessage For="@(() => newEmployee.Shift)" />
        </div>

        <div class="col-md-3">
            <InputText class="form-control"
                       @bind-Value="newEmployee.Department"
                       placeholder="Department" />
            <ValidationMessage For="@(() => newEmployee.Department)" />
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-success w-100"
                    disabled="@isSaving">
                @(isSaving
                    ? "Saving..."
                    : (isEditing ? "Update" : "Add"))
            </button>

        </div>
    </div>
</EditForm>


@code {

    private bool isSaving = false;
    private string message = "";
    private List<Employee> employees = new();
    private Employee newEmployee = new Employee
    {
        Shift = "Morning"
    };
    private string searchTerm = "";
    private string selectedShift = "";
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        employees = await EmployeeService.GetEmployees(searchTerm, selectedShift);
    }

    private async Task SaveEmployee()
    {
        isSaving = true;
        message = "";

        try
        {
            if (isEditing)
            {
                await EmployeeService.UpdateEmployee(newEmployee);
                message = "Employee updated successfully!";
                isEditing = false;
            }
            else
            {
                await EmployeeService.AddEmployee(newEmployee);
                message = "Employee added successfully!";
            }

            newEmployee = new Employee()
            {
                Shift = "Morning"
            };

            await LoadEmployees();
        }
        catch (Exception ex)
        {
            message = "Something went wrong!";
        }

        isSaving = false;
    }


    private void EditEmployee(Employee emp)
    {
        newEmployee = new Employee
        {
            Id = emp.Id,
            Name = emp.Name,
            Shift = emp.Shift,
            Department = emp.Department
        };

        isEditing = true;
    }

    private async Task DeleteEmployee(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this employee?");

        if (confirmed)
        {
            await EmployeeService.DeleteEmployee(id);
            await LoadEmployees();
        }
    }
}
